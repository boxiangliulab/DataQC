/*
 * -------------------------------------------------
 *  eQTLGen/dataqc Nextflow base config file
 * -------------------------------------------------
 * A 'blank slate' config file, appropriate for general
 * use on most high performace compute environments.
 * Assumes that all software is installed and available
 * on the PATH. Runs in `local` mode - all jobs will be
 * run on the logged in environment.
 */

process {

  // TODO nf-core: Check the defaults for all processes
  cpus = { check_max( 1 * task.attempt, 'cpus' ) }
  memory = { check_max( 7.GB * task.attempt, 'memory' ) }
  time = { check_max( 4.h * task.attempt, 'time' ) }

  errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
  maxRetries = 3
  maxErrors  = '-1'

  // Process-specific resource requirements
  // NOTE - Only one of the labels below are used in the fastqc process in the main script.
  //        If possible, it would be nice to keep the same label naming convention when
  //        adding in your processes.
  // TODO nf-core: Customise requirements for specific processes.
  // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
  withLabel:process_low {
    cpus = { check_max( 2 * task.attempt, 'cpus' ) }
    memory = { check_max( 14.GB * task.attempt, 'memory' ) }
    time = { check_max( 6.h * task.attempt, 'time' ) }
  }
  withLabel:process_medium {
    cpus = { check_max( 6 * task.attempt, 'cpus' ) }
    memory = { check_max( 42.GB * task.attempt, 'memory' ) }
    time = { check_max( 8.h * task.attempt, 'time' ) }
  }
  withLabel:process_high {
    cpus = { check_max( 12 * task.attempt, 'cpus' ) }
    memory = { check_max( 84.GB * task.attempt, 'memory' ) }
    time = { check_max( 10.h * task.attempt, 'time' ) }
  }
  withLabel:process_long {
    time = { check_max( 20.h * task.attempt, 'time' ) }
  }

  withName: ListChromosomes {
    memory = { check_max( 12.GB * task.attempt, 'memory' ) }
    cpus = 4
    time = { check_max( 2.h * task.attempt, 'time' ) }
  }

  withName: SplitVcf {
    memory = { check_max( 12.GB * task.attempt, 'memory' ) }
    cpus = 4
    time = { check_max( 4.h * task.attempt, 'time' ) }
  }

  withName: WgsNorm {
    memory = 24.GB    // NSCC 'normal' queue caps mem at 24gb; per-chr bcftools norm needs far less
    cpus = 4
    time = { check_max( 2.h * task.attempt, 'time' ) }
  }

  withName: WgsQC {
    memory = { check_max( 15.GB * task.attempt, 'memory' ) }
    cpus = 4
    time = { check_max( 11.h * task.attempt, 'time' ) }
  }

  withName: VcfToPlink {
    memory = 24.GB    // capped to NSCC 'normal' queue max (24gb)
    cpus = 4
    time = { check_max( 1.h * task.attempt, 'time' ) }
  }

  withName: MergePlink {
    memory = 24.GB    // capped to NSCC 'normal' queue max (24gb)
    cpus = 4
    time = { check_max( 2.h * task.attempt, 'time' ) }
  }

  withName: GenotypeQC {
    memory = { check_max( 15.GB * task.attempt, 'memory' ) }
    cpus = 4
    time = { check_max( 2.h * task.attempt, 'time' ) }
  }

  withName: SPLICING_SAMPLE_QC {
    // Selector MUST match the process name or it silently falls back to the 7GB default and OOM-kills.
    // ProcessSplicing.R computes the splicing PCA/MDS on the top-N most-variable junctions (--n_top_features,
    // default 20000; <=0 = all) and chunks the full-matrix var/INT/summary steps, so standard prcomp is used
    // (no Gram/dual PCA). Base 64GB handles typical cohorts (~1000 samples) in one attempt; for very wide
    // matrices the task OOM-retries up to max_memory (192GB) -> INTERVAL (673k junctions x 4496) peaks ~144GB
    // and succeeds on the 3rd attempt (64->128->192), all on a STANDARD node. For full-matrix (not top-feature)
    // PCA on a huge cohort, use the 1_DataQC_GRAM_PCA variant (Gram/dual PCA, needs a large-memory node).
    memory = { check_max( 64.GB * task.attempt, 'memory' ) }
    cpus = 4
    time = { check_max( 4.h * task.attempt, 'time' ) }
  }

  withName: EXPRESSION_SAMPLE_QC {
    // Faithful eQTLGen expression QC (CPM+TMM+INT, iterative PCA + MDS + sex check). ~20k genes so lighter
    // than splicing, but the MDS/apply steps + eQTLGen's ~25GB footprint make the 7GB default unsafe.
    memory = { check_max( 32.GB * task.attempt, 'memory' ) }
    cpus = 4
    time = { check_max( 4.h * task.attempt, 'time' ) }
  }

  withName: FINALIZE_SPLICING {
    // Active expression QC: re-align the splicing phenotype + covariate PCs to the final
    // geno n splice n expression set. Transposes the WIDE phenotype (samples x up-to-~670k features)
    // <-> TALL (numpy read avoids pandas' per-column OOM on 100k+ columns) and re-INTs per feature in R.
    // For a large cohort (e.g. INTERVAL 4411 x ~673k) the numpy array + R fread of the tall are each
    // ~24GB; size like SPLICING_SAMPLE_QC. Scale down for small cohorts if desired.
    memory = { check_max( 192.GB * task.attempt, 'memory' ) }
    cpus = 4
    time = { check_max( 6.h * task.attempt, 'time' ) }
  }

  withName: RenderReport {
    memory = { check_max( 5.GB * task.attempt, 'memory' ) }
    cpus = 1
    time = { check_max( 10.m * task.attempt, 'time' ) }
  }

}
