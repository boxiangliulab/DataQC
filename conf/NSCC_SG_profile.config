/*
 * -------------------------------------------------
 *  ISSAC-bulk Nextflow PBS config file
 * -------------------------------------------------
 */

executor {
    name = 'pbs'
    queueSize = 95
    submitRateLimit = 1
}

process {
  executor = 'pbs'
  queue = 'normal'
  clusterOptions = '-P 11003054'
}

// NSCC ASPIRE 2A has no setuid singularity, so unprivileged user namespaces are
// required. This is NSCC-specific and kept out of the shared `singularity` profile
// so other sites are not forced into --userns.
singularity {
  runOptions = '--userns'
}
